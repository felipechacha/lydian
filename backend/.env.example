# Ambiente da API: development, staging ou production.
NODE_ENV=development
# O Render fornece PORT automaticamente; 3000 é o padrão local.
PORT=3000

# Obrigatórias: o backend usa o client administrativo para Auth e Database.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opcionais no MVP: mantenha somente se algum fluxo futuro usar essas chaves.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Obrigatória: uma ou mais origens separadas por vírgula.
# Frontends externos permitidos. A origem da própria API/Swagger é aceita automaticamente.
CORS_ORIGIN=https://localhost:4200

# Recuperação: URL fixa do formulário de redefinição. Deve usar uma origem CORS permitida.
# Configurar também nos Redirect URLs e no template Recovery do Supabase.
PASSWORD_RESET_REDIRECT_URL=https://localhost:4200/reset-password/confirm
# default usa o template padrão limitado; token_hash requer template Recovery customizado/SMTP.
PASSWORD_RECOVERY_MODE=default
