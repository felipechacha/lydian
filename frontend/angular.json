{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "4332df38-c7be-4711-bd98-e4ee02a9c302"
  },
  "newProjectRoot": "projects",
  "projects": {
    "lydian-front": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:class": {},
        "@schematics/angular:directive": {},
        "@schematics/angular:guard": {},
        "@schematics/angular:interceptor": {},
        "@schematics/angular:pipe": {},
        "@schematics/angular:resolver": {},
        "@schematics/angular:service": {}
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index/production/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src"
              ]
            },
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "ssr": {
              "server": "src/main.server.ts",
              "outputMode": "server",
              "ssr": {
                "entry": "src/server.ts"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ]
            },
            "production": {
              "outputMode": "static",
              "ssr": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "40kB",
                  "maximumError": "80kB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "index": "src/index/non-production/index.html",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "ssr": false,
              "outputMode": "static",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "index": "src/index/non-production/index.html",
              "budgets": [],
              "outputHashing": "all",
              "optimization": true
            },
            "uat": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.uat.ts"
                }
              ],
              "index": "src/index/non-production/index.html",
              "budgets": [],
              "outputHashing": "all",
              "optimization": true
            },
            "stg": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.stg.ts"
                }
              ],
              "index": "src/index/non-production/index.html",
              "budgets": [],
              "outputHashing": "all",
              "optimization": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "lydian-front:build:production"
            },
            "development": {
              "buildTarget": "lydian-front:build:development",
              "proxyConfig": "proxy.conf.json"
            },
            "dev": {
              "buildTarget": "lydian-front:build:dev"
            },
            "uat": {
              "buildTarget": "lydian-front:build:uat"
            },
            "stg": {
              "buildTarget": "lydian-front:build:stg"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "lydian-front:build:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "providersFile": "src/test-providers.ts",
            "setupFiles": [
              "src/test-setup.ts"
            ]
          }
        }
      }
    }
  }
}
