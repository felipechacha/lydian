{
  "name": "lydian-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:ssr": "ng build --configuration ssr",
    "build:dev": "ng build --configuration dev",
    "build:uat": "ng build --configuration uat",
    "build:stg": "ng build --configuration stg",
    "container:build": "docker build -t lydian-front .",
    "container:run": "docker run --rm -p 8080:8080 -e API_UPSTREAM=https://lydian-app-api.onrender.com -e PORT=8080 lydian-front",
    "container:config:test": "docker run --rm -e API_UPSTREAM=https://lydian-app-api.onrender.com -e PORT=8080 lydian-front nginx -t",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "qa:browser": "agent-browser",
    "qa:browser:install": "agent-browser install",
    "qa:browser:doctor": "agent-browser doctor --offline --quick",
    "qa:browser:skill": "agent-browser skills get core",
    "qa:browser:skill:qa": "agent-browser skills get dogfood",
    "qa:browser:open": "agent-browser --session lydian-qa open https://localhost:4200",
    "qa:browser:open:headed": "agent-browser --session lydian-qa open https://localhost:4200 --headed",
    "qa:browser:snapshot": "agent-browser --session lydian-qa snapshot -i --json",
    "qa:browser:errors": "agent-browser --session lydian-qa errors --json",
    "qa:browser:a11y": "agent-browser --session lydian-qa a11y https://localhost:4200 --tags wcag2a,wcag2aa --json",
    "qa:browser:vitals": "agent-browser --session lydian-qa vitals https://localhost:4200 --json",
    "qa:browser:close": "agent-browser --session lydian-qa close",
    "serve:ssr:lydian-front": "node dist/lydian-front/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "ngx-toastr": "20.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.42",
    "agent-browser": "^0.34.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
